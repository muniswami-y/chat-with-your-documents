# Gemini API Keys (comma-separated for multi-key rotation and rate-limit fallback)
GEMINI_API_KEY=your_gemini_api_key_here,optional_second_key

# Gemini Models to try in order of fallback
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Embedding Model (Gemini)
EMBED_MODEL=gemini-embedding-001

# Optional Groq backup LLM (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
